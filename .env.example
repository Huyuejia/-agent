# MySQL
MYSQL_ROOT_PASSWORD=demo123456
MYSQL_DATABASE=customer_workbench
MYSQL_USER=demo_user
MYSQL_PASSWORD=demo_pass
MYSQL_PORT=3306
MYSQL_HOST=localhost

# PostgreSQL (pgvector) — used by Alembic migrations and ExactRetriever
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_workbench
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Full DSN (psycopg3); leave empty to build from the POSTGRES_* fields above
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_workbench

# Neo4j
NEO4J_AUTH=neo4j/demo123456
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=demo123456

# Backend
# Optional local demo override, e.g. sqlite:///./backend/data/demo.db
DATABASE_URL=
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CHROMA_PERSIST_DIR=./backend/data/chroma

# Demo user (no auth system)
DEMO_USER_ID=1
# true uses local fictional demo graph/RAG fallback when Docker services are unavailable
DEMO_OFFLINE_MODE=false

# Embedding model (local BGE-M3, not bge-small-zh-v1.5)
BGE_MODEL_PATH=./models/bge_m3
BGE_MODEL_NAME=BAAI/bge-m3
BGE_MODEL_VERSION=local-v1
BGE_EMBEDDING_DIMENSION=1024
BGE_DEVICE=auto
BGE_BATCH_SIZE=4
BGE_LOCAL_FILES_ONLY=true
