# PostgreSQL (pgvector) — used by Alembic migrations and ExactRetriever
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_workbench
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
# Full DSN (psycopg3); leave empty to build from the POSTGRES_* fields above
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_workbench

# Neo4j
NEO4J_AUTH=neo4j/demo123456
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=demo123456

# Redis (exact retrieval cache, cache-aside)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_EXACT_CACHE_TTL_SECONDS=300
REDIS_EXACT_CACHE_NEGATIVE_TTL_SECONDS=30
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# JWT access authentication (generate local RSA keys under ./secrets; never commit them)
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=customer-intelligence-auth
JWT_AUDIENCE=customer-intelligence-api
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900

# true uses local fictional demo graph/RAG fallback when Docker services are unavailable
DEMO_OFFLINE_MODE=false
# Optional OpenAI-compatible answer generation; leave URL empty for Evidence templates
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# Embedding model (local BGE-M3, not bge-small-zh-v1.5)
BGE_MODEL_PATH=./models/bge_m3
BGE_MODEL_NAME=BAAI/bge-m3
BGE_MODEL_VERSION=local-v1
BGE_EMBEDDING_DIMENSION=1024
BGE_DEVICE=auto
BGE_BATCH_SIZE=4
BGE_LOCAL_FILES_ONLY=true
